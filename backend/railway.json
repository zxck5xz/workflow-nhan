{
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "npx tsx src/server.js",
    "preDeployCommand": ["npx prisma migrate deploy"],
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
