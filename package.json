{
  "name": "workflow-nhan-root",
  "private": true,
  "workspaces": [
    "backend",
    "backend/worker",
    "task-dashboard",
    "mobile-app"
  ],
  "scripts": {
    "dev:backend": "npm run start --workspace=backend",
    "dev:frontend": "npm run dev --workspace=task-dashboard",
    "dev:mobile": "npm run start --workspace=mobile-app",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prepare": "husky"
  },
  "overrides": {
    "@types/react": "18.3.12"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.2"
  }
}
